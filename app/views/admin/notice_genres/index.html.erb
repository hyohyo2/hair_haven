<% flash.each do |message_type, message| %>
  <div class="flash-message <%= message_type %> "><%= message %></div>
<% end %>
<div class="text-center">
  <h3>お知らせジャンル登録/一覧</h3>
  <%= render "layouts/errors", obj: @notice_genre %>
</div>
<%= form_with model: [:admin, @notice_genre] do |f| %>
  <div class="row my-3">
    <div class="col"></div>
    <div class="col">
      <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="col">
      <%= f.submit "登録する", class: "btn btn-success" %>
    </div>
  </div>
<% end %>

<table class="table border-bottom text-center my-5">
  <thead>
    <th>ジャンル名</th>
    <th></th>
  </thead>
  <tbody>
    <% @notice_genres.each do |notice_genre| %>
    <tr>
      <td><%= notice_genre.name %></td>
      <td>
        <%= link_to "編集する", edit_admin_notice_genre_path(notice_genre), class: "btn btn-sm btn-secondary" %>
        <%= link_to admin_notice_genre_path(notice_genre), method: :delete, "data-confirm" => "本当に削除しますか？", class: "btn btn-sm btn-danger" do %>
          <i class="fa-solid fa-trash-can"></i>
        <% end %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>


