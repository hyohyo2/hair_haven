<%= form_with url: admin_search_result_path, method: :get, local: true do |f| %>
  <div class="row justify-content-center">
    <div class="col-1"></div>
    <div class="col-7">
      <%= f.text_field :content, class: "form-control" %>
    </div>
    <div class="col-4">
      <span class="select"><%= f.select(:model, options_for_select({"商品" => "item", "お知らせ" => "notice", "会員" => "user"})) %></span>
      <%= f.submit "検索", class: "btn btn-success ml-3" %>
    </div>
  </div>
<% end %>