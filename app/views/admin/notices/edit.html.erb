<% flash.each do |message_type, message| %>
  <div class="flash-message <%= message_type %> "><%= message %></div>
<% end %>
<div class="text-center">
  <h3>お知らせ内容編集</h3>
  <%= render "layouts/errors", obj: @notice %>
</div>
<%= form_with model: [:admin, @notice] do |f| %>
  <div class="row text-center my-3">
    <div class="col">
      <%= f.label "ジャンル" %>
    </div>
    <div class="col form-group">
      <%= f.collection_select(:notice_genre_id, NoticeGenre.all, :id, :name) %>
    </div>
  </div>
  <div class="row text-center my-3">
    <div class="col">
      <%= f.label "タイトル" %>
    </div>
    <div class="col form-group">
      <%= f.text_field :title, class: "form-control" %>
    </div>
  </div>
  <div class="row text-center my-3">
    <div class="col">
      <%= f.label "詳細" %>
    </div>
    <div class="col">
      <%= f.text_area :detail, rows: 5, class: "form-control" %>
    </div>
  </div>
  <div class="text-center">
    <%= f.submit "変更を登録", "data-confirm" => "本当に変更しますか", class: "btn btn-success" %>
  </div>
<% end %>
