<% flash.each do |message_type, message| %>
  <div class="flash-message <%= message_type %> "><%= message %></div>
<% end %>
<div class="text-center mb-3">
  <h3>お知らせ一覧</h3>
  <%= link_to new_admin_notice_path, class: "btn btn-outline-success" do %>
    お知らせ登録
    <i class="fa-solid fa-circle-plus"></i>
  <% end %>
  <%= link_to admin_notice_genres_path, class: "btn btn-outline-info" do %>
    お知らせジャンル
    <i class="fa-solid fa-tags"></i>
  <% end %>
</div>
<%= render "admin/notices/index", notices: @notices %>

