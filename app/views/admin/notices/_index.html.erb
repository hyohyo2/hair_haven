<table class="table table-hover border-bottom text-center">
  <thead>
    <th>日時</th>
    <th>タイトル</th>
    <th>ジャンル</th>
  </thead>
  <tbody>
    <% notices.each do |notice| %>
      <tr>
        <td><%= notice.created_at.strftime("%Y/%m/%d") %></td>
        <td>
          <%= link_to admin_notice_path(notice) do %>
            <%= notice.title %>
          <% end %>
        </td>
        <td><%= notice.notice_genre.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>