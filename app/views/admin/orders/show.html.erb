<h3>
  <%= link_to admin_root_path do %>
    <i class="fa-solid fa-circle-chevron-left"></i>
  <% end %>
  注文履歴詳細
</h3>

<div class="mt-3">
  <h4><strong>注文情報</strong></h4>
  <table class="table border-bottom text-center">
    <tr>
      <th>注文日</th>
      <td> <%= @order.created_at.strftime("%Y/%m/%d %H:%M:%S") %></td>
    </tr>
    <tr>
      <th>購入者</th>
      <td>
        <%= link_to admin_user_path do %>
          <%= @order.name %>
        <% end %>
      </td>
    </tr>
    <tr>
      <th>配送先</th>
      <td><%= @order.address %></td>
    </tr>
    <tr>
      <th>支払方法</th>
      <td><%= @order.payment_method_i18n %></td>
    </tr>
    <tr>
      <%= form_with model: [:admin, @order], method: :patch, local: true do |f| %>
        <th class="align-middle"><%= f.label "注文ステータス" %></th>
        <td>
          <div class="select-btn">
            <%= f.select(:order_status, Order.order_statuses_i18n.invert, {}, class: "form-control text-center mr-3") %>
            <%= f.submit "更新", class: "btn btn-sm btn-success" %>
          </div>
        </td>
      <% end %>
    </tr>
  </table>
</div>

<div class="my-3">
  <h4><strong>商品情報</strong></h4>
  <table class="table border-bottom text-center">
    <thead>
      <th>商品名</th>
      <th>単価(税込)</th>
      <th>数量</th>
      <th>小計</th>
      <th>ステータス</th>
    </thead>
    <tbody>
      <% @order_details.each do |order_detail| %>
        <tr>
          <td class="align-middle"><%= order_detail.item.name %></td>
          <td class="align-middle"><%= order_detail.price.to_s(:delimited) %></td>
          <td class="align-middle"><%= order_detail.amount %></td>
          <td class="align-middle"><%= order_detail.subtotal.to_s(:delimited) %></td>
          <%= form_with model: [:admin, order_detail], method: :patch, local: true do |f| %>
            <td>
              <div class="select-btn">
                <%= f.select(:making_status, OrderDetail.making_statuses_i18n.invert, {}, class: "form-control text-center mr-3") %>
                <%= f.submit "更新", class: "btn btn-sm btn-success" %>
              </div>
            </td>
          <% end %>
        <tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mb-3">
  <h4><strong>請求情報</strong></h4>
  <table class="table border-bottom text-center">
    <tr>
      <th>商品合計</th>
      <td><%= @order.get_total_price.to_s(:delimited) %>円</td>
    </tr>
    <tr>
      <th>送料</th>
      <td><%= @order.shipping_cost %>円</td>
    </tr>
    <tr>
      <th>請求金額</th>
      <td><%= @order.get_billed_amount.to_s(:delimited) %>円</td>
    </tr>
    <tr>
      <th>内消費税</th>
      <td><%= @order.get_only_tax.to_s(:delimited) %>円</td>
    </tr>
  </table>
</div>
