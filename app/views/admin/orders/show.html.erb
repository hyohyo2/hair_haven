<div class="text-center">
  <h3>
    <%= link_to admin_root_path do %>
      <i class="fa-solid fa-circle-chevron-left"></i>
    <% end %>
    注文履歴詳細
  </h3>
  <div class="my-5">
    <div>
      <label>注文日</label>
      <%= @order.created_at.strftime("%Y/%m/%d %H:%M:%S") %>
    </div>
    <div>
      <label>購入者</label>
      <%= @order.name %>
    </div>
    <div>
      <label>配送先</label>
      <%= @order.address %>
    </div>
    <div>
      <label>支払方法</label>
      <%= @order.payment_method_i18n %>
    </div>
    <!--フォームに変えること-->
    <div>
      <label>注文ステータス</label>
      <%= @order.order_status_i18n %>
    </div>
  </div>
  <div class="mb-5">
    <table class="table table-hover table-inverse border-bottom text-center">
      <thead>
        <th>商品名</th>
        <th>単価(税込)</th>
        <th>数量</th>
        <th>小計</th>
        <th>ステータス</th>
        <th></th>
      </thead>
      <tbody>
        <% @order_details.each do |order_detail| %>
          <tr>
            <td><%= order_detail.item.name %></td>
            <td><%= order_detail.item.add_tax_price.to_s(:delimited) %></td>
            <td><%= order_detail.amount %></td>
            <td><%= order_detail.subtotal.to_s(:delimited) %></td>
            <!--セレクトボタンにする-->
            <td><%= order_detail.making_status_i18n %></td>

          <tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div>
    <div>
      <label>商品合計</label>
      <%= @order.get_total_price.to_s(:delimited) %>円
    </div>
    <div>
      <label>送料</label>
      <%= @order.get_shipping_cost.floor %>円
    </div>
    <div>
      <label>内消費税</label>
      <%= @order.get_only_tax.floor.to_s(:delimited) %>円
    </div>
    <div>
      <label>請求金額合計</label>
      <%= @order.get_billed_amount.floor.to_s(:delimited) %>円
    </div>
  </div>

</div>