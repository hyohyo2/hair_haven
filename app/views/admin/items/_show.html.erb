<div class="row my-3">
  <div class="col text-right">
    <label>税抜価格：</label>
  </div>
  <div class="col text-left">
    <%= item.price.to_s(:delimited) %>円(<%= item.add_tax_price.to_s(:delimited) %>円)
  </div>
</div>
<div class="row my-3">
  <div class="col text-right">
    <label>サイズ：</label>
  </div>
  <div class="col text-left">
    <%= item.size_i18n %>
  </div>
</div>
<div class="row my-3">
  <div class="col text-right">
    <label>長さ：</label>
  </div>
  <div class="col text-left">
    <%= item.length_i18n %>
  </div>
</div>
<div class="row my-3">
  <div class="col text-right">
    <label>カラー：</label>
  </div>
  <div class="col text-left">
    <%= item.color %>
  </div>
</div>

<!--ラベルレイアウト修正-->
<div class="row my-3">
  <div class="col text-right">
    <label>詳細：</label>
  </div>
  <div class="col text-left">
    <%= simple_format(item.detail, sanitize: true) %>
  </div>
</div>