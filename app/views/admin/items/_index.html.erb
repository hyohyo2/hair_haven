<table class="table table-hover table-inverse border-bottom text-center">
  <thead>
    <th>商品ID</th>
    <th>商品名</th>
    <th>税抜価格</th>
    <th>レビュー</th>
    <th>ステータス</th>
  </thead>
  <% items.each do |item| %>
    <tbody>
        <tr>
          <td><%= item.id %></td>
          <td>
            <%= link_to admin_item_path(item.id) do %>
              <%= item.name %>
            <% end %>
          </td>
          <td><%= item.price.to_s(:delimited) %></td>
          <td>
            <% if item.reviews.present? %>
              <%= link_to admin_item_reviews_path(item) do %>
                <%= item.reviews.average(:star).floor(1) %>(<%= item.reviews.count(:star) %>)
              <% end %>
            <% else %>
              ー
            <% end %>
          </td>
          <td>
            <% if item.is_active == true %>
              <span class="text-success">販売中</span>
            <% else %>
              <span class="text-secondary">販売停止中</span>
            <% end %>
          </td>
        </tr>
    </tbody>
  <% end %>
</table>