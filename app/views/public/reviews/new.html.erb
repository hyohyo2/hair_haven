<div class="container my-3">
  <% flash.each do |message_type, message| %>
    <div class="flash-message <%= message_type %>"><%= message %></div>
  <% end %>
  <div class="text-center">
    <h3>レビュー投稿</h3>
    <div><%= image_tag @item.get_image(160,120), class: "index-img" %></div>
    <div><%= @item.name %></div>
    <%= form_with model: [@item, @review] do |f| %>

    <% if @review.id.nil? %>
      <div class="field d-flex" id="star">
        <div class="col-3">
          <label>評価</label>
        </div>
        <%= f.hidden_field :star, id: :review_star, class: "form-control" %>
        <div class="col-6" id="post_raty"></div>
      </div>
      <script>
        $(document).on('turbolinks:load', function(){
          let elem = document.querySelector('#post_raty');
          if (elem == null) return;

          elem.innerHTML = ""
          let opt = {
            starOn: "<%= asset_path('star-on.png') %>",
            starOff: "<%= asset_path('star-off.png') %>",
            starHalf: "<%= asset_path('star-half.png') %>",
            scoreName: 'review[star]',
          };
          raty(elem, opt);
        });
      </script>
    <% else %>
      <div class="form-group">
        <%= render "static_rate", review: @review %>
      </div>
    <% end %>

    <div class="field d-flex">
      <div class="col-3">
        <label>サイズ</label>
      </div>
      <div class="col-6">
        <%= @item.size_i18n %>
      </div>
    </div>
    <div class="field d-flex">
      <div class="col-3">
        <label>色</label>
      </div>
      <div class="col-6">
        <%= @item.color %>
      </div>
    </div>
    <!--性別選択-->
    <div class="field d-flex">
      <div class="col-3">
        <label>タイトル</label>
      </div>
      <div class="col-6">
        <%= f.text_field :title, autocomplete: "title", class: "form-control" %>
      </div>
    </div>
    <div class="field d-flex">
      <div class="col-3">
        <label>レビュー内容</label>
      </div>
      <div class="col-6">
        <%= f.text_area :detail, rows: '5', autocomplete: "detail", class: "form-control" %>
      </div>
    </div>
    <div class="actions">
      <%= f.submit "レビューを投稿する", class: "btn btn-success" %>
    </div>
    <% end %>
  </div>

</div>