<div class="container my-3">
  <div class="text-center">
    <h3>レビュー投稿</h3>
    <div><%= image_tag @item.get_image(160,120), class: "index-img" %></div>
    <div><%= @item.name %></div>
    <%= form_with model: [@item, @review] do |f| %>
    <div class="field d-flex">
      <div class="col-3">
        <label>サイズ</label>
      </div>
      <div class="col-6">
        <%= @item.size_i18n %>
      </div>
    </div>
    <div class="field d-flex">
      <div class="col-3">
        <label>色</label>
      </div>
      <div class="col-6">
        <%= @item.color %>
      </div>
    </div>
    <!--性別選択-->
    <div class="field d-flex">
      <div class="col-3">
        <label>タイトル</label>
      </div>
      <div class="col-6">
        <%= f.text_field :title, autocomplete: "title", class: "form-control" %>
      </div>
    </div>
    <div class="field d-flex">
      <div class="col-3">
        <label>レビュー内容</label>
      </div>
      <div class="col-6">
        <%= f.text_area :detail, rows: '5', autocomplete: "detail", class: "form-control" %>
      </div>
    </div>
    <div class="actions">
      <%= f.submit "レビューを投稿する", class: "btn btn-success" %>
    </div>
    <% end %>
  </div>

</div>