<% flash.each do |message_type, message| %>
  <div class="flash-message <%= message_type %> "><%= message %></div>
<% end %>
<% if current_user.cart_items.present? %>
  <table class="table border-bottom text-center">
    <thead>
      <tr>
        <th></th>
        <th>商品名</th>
        <th>単価</th>
        <th>数量</th>
        <th>小計</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @cart_items.each do |cart_item| %>
        <tr>
          <td><%= image_tag cart_item.item.get_image(120,80), class: "index-img" %></td>
          <td class="align-middle"><%= cart_item.item.name %></td>
          <td class="align-middle"><%= cart_item.item.add_tax_price.to_s(:delimited) %>円</td>
          <td class="align-middle">
            <%= form_with model: cart_item, url: cart_item_path(cart_item), local: true, method: :patch do |f| %>
              <%= f.select :amount, *[1..10] %>
              <%= f.submit "変更" %>
            <% end %>

          </td>
          <td class="align-middle"><%= cart_item.subtotal.to_s(:delimited) %>円</td>
          <td class="align-middle">
            <%= link_to cart_item_path(cart_item), method: :delete, "data-confirm" => "本当にこの商品を削除しますか", class: "btn btn-sm btn-secondary" do %>
              <i class="fa-solid fa-trash-can"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
      <tr>
        <td colspan="2"></td>
        <th>合計(税込)</th>
        <td>
            <%= @total_price.to_s(:delimited) %>円
          
        <td colspan="2"></td>
      </tr>
    </tbody>
  </table>
  <div class="text-center">
    <%= link_to "注文情報入力に進む", new_order_path, class: "btn btn-success" %>
    <%= link_to "全ての商品を削除する", destroy_all_path, method: :delete, "data-confirm" => "本当に全商品削除してもよろしいですか", class: "btn btn-danger" %>
  </div>


<% else %>
  <h2 class="text-center my-5">商品をカートに入れると表示されます。</h2>
<% end %>

