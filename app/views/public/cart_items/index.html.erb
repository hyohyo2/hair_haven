<% flash.each do |message_type, message| %>
  <div class="flash-message <%= message_type %> "><%= message %></div>
<% end %>
<% if current_user.cart_items.present? %>
  <table class="table">
    <thead>
      <tr>
        <th></th>
        <th>商品名</th>
        <th>単価</th>
        <th>数量</th>
        <th>小計</th>
      </tr>
    </thead>
    <tbody>
      <% total = 0 %>
      <% @cart_items.each do |cart_item| %>
        <tr>
          <td><%= image_tag cart_item.item.get_image(120,80), class: "index-img" %></td>
          <td><%= cart_item.item.name %></td>
          <td><%= cart_item.item.add_tax_price.to_s(:delimited) %>円</td>
          <td>
            <%= form_with model: cart_item, url: cart_item_path(cart_item), local: true, method: :patch do |f| %>
              <%= f.select :amount, *[1..10] %>
              <%= f.submit "変更" %>
            <% end %>
            <%= link_to cart_item_path(cart_item), method: :delete, "data-confirm" => "本当にこの商品を削除しますか" do %>
              <i class="fa-solid fa-trash-can"></i>
            <% end %>
          </td>
          <td><%= cart_item.subtotal.to_s(:delimited) %>円</td>
        </tr>
        <% total += cart_item.subtotal %>
      <% end %>
    </tbody>
  </table>
  <span><label>合計金額</label><%= total.to_s(:delimited) %></span>
  <%= link_to "全ての商品を削除する", destroy_all_path, method: :delete, "data-confirm" => "本当に全商品削除してもよろしいですか", class: "btn btn-sm btn-danger" %>
<% else %>
  <h2 class="text-center my-5">商品をカートに入れると表示されます。</h2>
<% end %>

