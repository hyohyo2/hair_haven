<div class="text-center">
  <h3>お知らせ</h3>
</div>
<div class="notice-index">
  <% @notices.each do |notice| %>
    <div class="row my-3">
      <div class="col-4"></div>
      <div class="col-2"><%= notice.created_at.strftime("%Y/%m/%d") %></div>
      <div class="col-6 text-left">
        <%= link_to notice_path(notice) do %>
          <%= notice.title %>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="text-center"><%= link_to "お知らせ一覧へ", notices_path, class: "btn btn-light" %></div>
</div>

