<div class="container my-3">
  <% flash.each do |message_type, message| %>
    <div class="flash-message <%= message_type %>"><%= message %></div>
  <% end %>

  <%#= render "layouts/errors", obj: @address %>

  <div class="text-center">
    <h3>配送先情報編集</h3>

    <div class="my-3">
      <%= form_with model: @address do |f| %>
        <div class="field d-flex">
          <div class="col-3">
            <label>郵便番号</label>
          </div>
          <div class="col-3">
            <%= f.text_field :post_code, autofocus: true , autocomplete: "post_code", placeholder: "123-4567", class: "form-control" %>
          </div>
        </div>
        <div class="field d-flex">
          <div class="col-3">
            <label>住所</label>
          </div>
          <div class="col-6">
            <%= f.text_field :address, autocomplete: "address", class: "form-control" %>
          </div>
        </div>
        <div class="field d-flex">
          <div class="col-3">
            <label>宛名</label>
          </div>
          <div class="col-6">
            <%= f.text_field :name, autocomplete: "name", class: "form-control" %>
          </div>
        </div>
        <div class="actions">
          <%= f.submit "変更内容を保存", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
