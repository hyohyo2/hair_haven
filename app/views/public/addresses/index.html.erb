<div class="container my-3">
  <% flash.each do |message_type, message| %>
    <div class="flash-message <%= message_type %>"><%= message %></div>
  <% end %>
  <div class="text-center">
    <h3>配送先登録/一覧</h3>

    <div>
      <%= form_with model: @address do |f| %>
        <div class="field d-flex">
          <div class="col-3">
            <label>郵便番号</label>
          </div>
          <div class="col-3">
            <%= f.text_field :post_code, autofocus: true , autocomplete: "post_code", class: "form-control" %>
          </div>
        </div>
        <div class="field d-flex">
          <div class="col-3">
            <label>住所</label>
          </div>
          <div class="col-6">
            <%= f.text_field :address, autocomplete: "address", class: "form-control" %>
          </div>
        </div>
        <div class="field d-flex">
          <div class="col-3">
            <label>宛名</label>
          </div>
          <div class="col-6">
            <%= f.text_field :name, autocomplete: "name", class: "form-control" %>
          </div>
        </div>
        <div class="actions">
          <%= f.submit "配送先を登録", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
    <div class="table">
      <table>
        <thead>
          <th>No</th>
          <th>郵便番号</th>
          <th>住所</th>
          <th>宛名</th>
        </thead>

        <tbody>
          <% @addresses.each do |address| %>
            <td><%= address.id %></td>
            <td><%= address.post_code %></td>
            <td><%= address.address %></td>
            <td><%= address.name %></td>
          <% end %>
        </tbody>
      </table>



    </div>
  </div>

</div>