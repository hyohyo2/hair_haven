<div class="container my-3">
  <% flash.each do |message_type, message| %>
    <div class="flash-message <%= message_type %>"><%= message %></div>
  <% end %>

  <%= render "layouts/errors", obj: @address %>

  <div class="text-center">
    <h3>
      <%= link_to mypage_path do %>
        <i class="fa-solid fa-circle-chevron-left"></i>
      <% end %>
      配送先登録/一覧</h3>

    <div class="my-3">
      <%= form_with model: @address do |f| %>
        <div class="field d-flex">
          <div class="col-3">
            <label>郵便番号</label>
          </div>
          <div class="col-3">
            <%= f.text_field :post_code, autofocus: true , autocomplete: "post_code", placeholder: "123-4567", class: "form-control" %>
          </div>
        </div>
        <div class="field d-flex">
          <div class="col-3">
            <label>住所</label>
          </div>
          <div class="col-6">
            <%= f.text_field :address, autocomplete: "address", class: "form-control" %>
          </div>
        </div>
        <div class="field d-flex">
          <div class="col-3">
            <label>宛名</label>
          </div>
          <div class="col-6">
            <%= f.text_field :name, autocomplete: "name", class: "form-control" %>
          </div>
        </div>
        <div class="actions">
          <%= f.submit "配送先を登録", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
      <table class="table table-hover border-bottom">
        <thead>
          <th>郵便番号</th>
          <th>住所</th>
          <th>宛名</th>
          <th></th>
        </thead>
        <% @addresses.each do |address| %>
        <tbody>
            <td>〒<%= address.post_code %></td>
            <td><%= address.address %></td>
            <td><%= address.name %></td>
            <td>
              <%= link_to "編集", edit_address_path(address.id), class: "btn btn-sm btn-secondary" %>
              <%= link_to address_path(address.id), method: :delete, "data-confirm" => "本当に削除しますか？", class: "btn btn-sm btn-danger" do %>
                <i class="fa-solid fa-trash-can"></i>
              <% end %>
            </td>
        </tbody>
        <% end %>
      </table>
  </div>

</div>