<div class="container my-3">
  <div class="row">
    <% @items.each do |item| %>
      <% if item.is_active == true %>
        <div class="col-3">
          <div><%= image_tag item.get_image(150,100) %></div>
          <div><%= item.name %></div>
          <div><%= item.length_i18n %></div>
          <div><%= item.price.to_s(:delimited) %>円(税抜)</div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>