<div class="container my-3">
  <div class="row text-center">
    <% @items.each do |item| %>
      <% if item.is_active == true %>
        <div class="col-3">
          <%= link_to item_path(item.id) do %>
            <div><%= image_tag item.get_image(150,100), class: "index-img" %></div>
            <div><%= item.name %></div>
          <% end %>
          <div id="favorite_buttons_<%= item.id %>">
            <%= render "public/favorites/btn", item: item %>
          </div>
          <div class="my-1"><%= item.length_i18n %></div>
          <div class="my-1"><%= item.price.to_s(:delimited) %>円(税抜)</div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>