<% flash.each do |message_type, message| %>
  <div class="flash-message <%= message_type %>"><%= message %></div>
<% end %>
<% if @item.is_active == true %>
  <div class="text-center">
    <h2 class="my-3">商品詳細</h2>
    <div>
      <%= image_tag @item.get_image(300,300), class: "show-img" %>
    </div>
    <!--タグ表示-->
    <div class="my-3">
      <% @item.tags.each do |tag| %>
        <span class="checkbox-item">
          <%= link_to item_index_path(tag) do %>
            <%= tag.name %>
          <% end %>
        </span>
      <% end %>
    </div>
    <div class="row my-3">
      <div class="col text-right">
        <label>商品名：</label>
      </div>
      <div class="col text-left">
        <%= @item.name %>
        <span id="favorite_buttons_<%= @item.id %>">
          <%= render "public/favorites/btn", item: @item %>
        </span>
      </div>
    </div>
    <div class="row my-3">
      <div class="col text-right">
        <label>評価：</label>
      </div>
      <div class="col text-left">
        <% if @item.reviews.present? %>
          <%= @item.reviews.average(:star).floor(1) %>(<%= @item.reviews.count(:star) %>)
        <% else %>
          ー
        <% end %>
      </div>
    </div>

    <%= render "admin/items/show", item: @item %>


    <div>
      <% if user_signed_in? %>
        <%= form_with model: @cart_item, local: true do |f| %>
          <div class="row my-3">
            <div class="col text-right">
              <%= f.label :amount , "個数選択：" %>
            </div>
            <div class="col text-left">
              <%= f.select :amount, *[1..10] %>
            </div>
          </div>
          <div class="my-3">
            <%= f.hidden_field :item_id, :value => @item.id %>
            <%= f.submit "カートに入れる", class: "btn btn-success" %>
          </div>
        <% end %>
        <div class="my-3">
          <%= link_to "レビューを投稿", new_item_review_path(@item.id), class: "btn btn-warning" %>
        </div>
      <% end %>
      <% if @item.reviews.present? %>
        <div class="my-3">
          <%= link_to "全レビューを見る", item_reviews_path(@item.id), class: "btn btn-info" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>