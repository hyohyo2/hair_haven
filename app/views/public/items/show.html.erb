<div class="container my-3">
  <% flash.each do |message_type, message| %>
    <div class="flash-message <%= message_type %>"><%= message %></div>
  <% end %>
  <div class="text-center">
    <h2 class="my-3">商品詳細</h2>
    <div>
      <%= image_tag @item.get_image(300,300), class: "show-img" %>
    </div>
    <div class="my-3">
      <label>商品名：</label>
      <%= @item.name %>
      <%= render "public/favorites/btn", item: @item %>
    </div>
    <div class="my-3">
      <label>評価：</label>
      <% if @item.reviews.present? %>
        <%= @item.reviews.average(:star).floor(1) %>(<%= @item.reviews.count(:star) %>)
      <% else %>
        ー
      <% end %>
    </div>
    <div class="my-3">
      <label>税抜価格：</label>
      <%= @item.price.to_s(:delimited) %>円(<%= @item.add_tax_price.to_s(:delimited) %>円)
    </div>
    <div class="my-3">
      <label>サイズ：</label>
      <%= @item.size_i18n %>
    </div>
    <div class="my-3">
      <label>長さ：</label>
      <%= @item.length_i18n %>
    </div>
    <div class="my-3">
      <label>カラー：</label>
      <%= @item.color %>
    </div>
    <!--ラベル改行修正-->
    <div class="my-3">
      <label>詳細：</label>
      <%= simple_format(@item.detail, sanitize: true) %>
    </div>

    <div>
      <%= link_to "レビューを投稿", new_item_review_path(@item.id), class: "btn btn-warning" %>
      <% if @item.reviews.present? %>
        <%= link_to "全レビューを見る", item_reviews_path(@item.id), class: "btn btn-info" %>
      <% end %>
    </div>
  </div>
</div>