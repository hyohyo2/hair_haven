<h3>
  <%= link_to new_order_path do %>
    <i class="fa-solid fa-circle-chevron-left"></i>
  <% end %>
  注文情報確認
</h3>
<table class="table border-bottom text-center">
  <% total = 0 %>
  <% @cart_items.each do |cart_item| %>
    <tr>
      <td>
        <div><%= image_tag cart_item.item.get_image(150,120), class: "index-img" %></div>
        <div><%= cart_item.item.name %></div>
      </td>
      <td>
        <%= cart_item.item.price.to_s(:delimited) %>円
      </td>
      <td>
        <%= cart_item.amount %>
      </td>
      <td>
        <%= cart_item.subtotal.to_s(:delimited) %>円
      </td>
    </tr>
    <!--商品ごとの小計をすべて合計するものを"total"に代入-->
    <% total += cart_item.subtotal %>
  <% end %>
</table>

<div class="text-center">
  <label>合計金額</label>
  <%= total.to_s(:delimited) %>円
</div>
<div class="text-center">
  <label>配送料</label>
  <%= @order.shipping_cost %>円
</div>
<div class="text-center">
  <label>請求額</label>
  <% @order.total_payment = total + @order.shipping_cost %>
  <%= @order.total_payment.to_s(:delimited) %>円
</div>
<!--リーダブルコード修正必要-->
<div class="text-center">
  <label>内消費税</label>
  <% get_only_tax_cost = @order.total_payment/11 %>
  <%= get_only_tax_cost.to_s(:delimited) %>円
</div>

<div class="text-center">
  <label>支払方法</label>
  <%= @order.payment_method_i18n %>
</div>

<div class="text-center">
  <label>お届け先</label>
  <div>〒<%= @order.post_code %></div>
  <div><%= @order.address %></div>
  <div><%= @order.name %></div>
</div>
<div class="text-center">
  <%= form_with model: @order, url: orders_path, method: :post, local: true do |f| %>
    <%= f.hidden_field :user_id %>
    <%= f.hidden_field :post_code %>
    <%= f.hidden_field :address %>
    <%= f.hidden_field :name %>
    <%= f.hidden_field :shipping_cost %>
    <%= f.hidden_field :total_payment %>
    <%= f.hidden_field :payment_method %>
    <%= f.hidden_field :order_status %>
    <%= f.submit "注文を確定する", class: "btn btn-success" %>
  <% end %>
</div>

